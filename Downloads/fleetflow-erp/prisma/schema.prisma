generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── SaaS Tier ───────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   // Basic, Professional, Enterprise
  price         Float    // monthly KES
  currency      String   @default("KES")
  maxVehicles   Int
  maxDrivers    Int
  maxUsers      Int
  features      String   // JSON array stored as string
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  email         String
  phone         String?
  address       String?
  city          String?
  country       String   @default("Kenya")
  logoUrl       String?
  status        String   @default("active") // active | suspended | trial
  trialEndsAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscription          Subscription?
  subscriptionPayments  SubscriptionPayment[]
  users             User[]
  customers         Customer[]
  drivers           Driver[]
  vehicles          Vehicle[]
  orders            Order[]
  dispatchJobs      DispatchJob[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          Expense[]
  fuelRecords       FuelRecord[]
  maintenanceRecords MaintenanceRecord[]
  inventoryItems    InventoryItem[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  companySettings   CompanySettings?
  customerPortalAccounts CustomerPortalAccount[]
  driverPayRates    DriverPayRate[]
  payrollRuns       PayrollRun[]
  waterSources      WaterSource[]
}

model WaterSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String
  lat            Float?
  lng            Float?
  price5000      Float    @default(0)
  price10000     Float    @default(0)
  price20000     Float    @default(0)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  dispatchJobs  DispatchJob[]
}

model Subscription {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  planId          String
  status          String    @default("trial") // trial | active | expired | suspended | cancelled
  trialEnd        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt     DateTime?
  suspendedAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id])
  payments     SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String    @id @default(cuid())
  organizationId String
  subscriptionId String
  invoiceNumber  String    @unique
  amount         Float
  currency       String    @default("KES")
  plan           String
  method         String    @default("bank_transfer") // mpesa | stripe | bank_transfer
  status         String    @default("paid") // pending | paid | failed | refunded
  reference      String?
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  organizationId String?  // null = Super Admin
  email          String?  @unique
  passwordHash   String
  name           String
  phone          String?
  role           String   // super_admin | company_admin | dispatcher | driver | accountant | mechanic | customer_support
  avatarUrl      String?
  isActive       Boolean  @default(true)
  monthlySalary  Float?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization? @relation(fields: [organizationId], references: [id])
  driver            Driver?
  auditLogs         AuditLog[]    @relation("AuditUser")
  conductorJobs     DispatchJob[] @relation("DispatchConductor")
}

// ─── Core Business Models ─────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String
  address        String
  city           String   @default("Nairobi")
  type           String   @default("business") // business | residential
  creditLimit    Float    @default(0)
  balance        Float    @default(0) // outstanding balance
  status         String   @default("active")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  orders       Order[]
  invoices     Invoice[]
  portalAccount CustomerPortalAccount?
}

model VehicleType {
  id          String @id @default(cuid())
  name        String // Water Tanker, Fuel Truck, Pickup, etc.
  capacityUnit String // litres, kg, tonnes
  vehicles    Vehicle[]
}

model Vehicle {
  id               String   @id @default(cuid())
  organizationId   String
  plateNumber      String
  typeId           String?
  make             String
  model            String
  year             Int
  capacityLitres   Float    @default(0)
  status           String   @default("available") // available | on_trip | maintenance | off_duty
  fuelType         String   @default("diesel")
  odometerKm       Float    @default(0)
  insuranceExpiry  DateTime?
  nextServiceKm    Float?
  color            String?
  imageUrl         String?
  ownership        String   @default("owned") // owned | leased
  leaseCompany     String?
  leaseExpiry      DateTime?
  leaseMonthlyRate Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])
  vehicleType      VehicleType? @relation(fields: [typeId], references: [id])
  dispatchJobs     DispatchJob[]
  fuelRecords      FuelRecord[]
  maintenanceRecords MaintenanceRecord[]
}

model Driver {
  id               String   @id @default(cuid())
  organizationId   String
  userId           String?  @unique
  name             String
  phone            String
  email            String?
  licenseNumber    String
  licenseExpiry    DateTime
  status           String   @default("available") // available | on_trip | off_duty | suspended
  avatarUrl        String?
  rating           Float    @default(5.0)
  totalTrips       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id])
  user          User?            @relation(fields: [userId], references: [id])
  dispatchJobs  DispatchJob[]
  locations     DriverLocation[]
  payRate       DriverPayRate?
  payrollLines  PayrollRunLine[]
}

model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String
  lat       Float
  lng       Float
  accuracy  Float?
  speed     Float?
  heading   Float?
  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])
}

model Order {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  orderNumber    String
  status         String   @default("pending") // pending | confirmed | dispatched | in_progress | delivered | cancelled
  priority       String   @default("normal") // low | normal | high | urgent
  type           String   @default("delivery") // delivery | pickup | transfer
  productType    String   @default("water") // water | fuel | goods
  quantityOrdered Float
  unit           String   @default("litres")
  deliveryAddress String
  deliveryLat    Float?
  deliveryLng    Float?
  scheduledAt    DateTime?
  notes          String?
  totalAmount    Float    @default(0)
  waterSourceId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  dispatchJob  DispatchJob?
  invoice      Invoice?
  auditLogs    AuditLog[]
}

model DispatchJob {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String   @unique
  driverId       String?
  vehicleId      String?
  conductorId    String?
  waterSourceId  String?
  status         String   @default("unassigned") // unassigned | assigned | accepted | en_route_source | loading | en_route_customer | arrived | delivered | cancelled | failed
  priority       Boolean  @default(false)
  assignedAt     DateTime?
  acceptedAt     DateTime?
  pickupLat      Float?
  pickupLng      Float?
  pickupAddress  String?
  actualQuantity Float?
  cashCollected  Float?
  driverNotes    String?
  startedAt      DateTime?
  arrivedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])
  order            Order        @relation(fields: [orderId], references: [id])
  driver           Driver?      @relation(fields: [driverId], references: [id])
  vehicle          Vehicle?     @relation(fields: [vehicleId], references: [id])
  conductor        User?        @relation("DispatchConductor", fields: [conductorId], references: [id])
  waterSource      WaterSource? @relation(fields: [waterSourceId], references: [id])
  proofOfDelivery  ProofOfDelivery?
  auditLogs        AuditLog[]
}

model ProofOfDelivery {
  id            String   @id @default(cuid())
  dispatchJobId String   @unique
  photoUrl      String?
  signatureUrl  String?
  recipientName String?
  deliveredAt   DateTime @default(now())
  lat           Float?
  lng           Float?
  notes         String?
  createdAt     DateTime @default(now())

  dispatchJob DispatchJob @relation(fields: [dispatchJobId], references: [id])
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  orderId        String?  @unique
  invoiceNumber  String
  status         String   @default("draft") // draft | sent | paid | overdue | cancelled
  subtotal       Float
  taxRate        Float    @default(16) // VAT %
  taxAmount      Float
  totalAmount    Float
  paidAmount     Float    @default(0)
  dueDate        DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  payments     Payment[]
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  amount         Float
  method         String   // cash | mpesa | bank_transfer | cheque
  reference      String?
  notes          String?
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  category       String   // fuel | maintenance | salary | insurance | license | office | other
  description    String
  amount         Float
  vendor         String?
  receiptUrl     String?
  date           DateTime
  approvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ─── Fleet Operations ─────────────────────────────────────────────────────────

model FuelRecord {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  litres         Float
  costPerLitre   Float
  totalCost      Float
  odometerKm     Float
  station        String?
  attendant      String?
  receiptNumber  String?
  date           DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
}

model MaintenanceRecord {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  type           String   // service | repair | inspection | tire | battery | other
  description    String
  odometerKm     Float
  cost           Float
  vendor         String?
  mechanicNotes  String?
  nextServiceKm  Float?
  nextServiceDate DateTime?
  status         String   @default("completed") // scheduled | in_progress | completed
  date           DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  parts        InventoryTransaction[]
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String   // tire | hose | pump | filter | oil | spare_part | other
  sku            String?
  quantity       Int      @default(0)
  reorderLevel   Int      @default(5)
  unitCost       Float
  supplier       String?
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id])
  transactions  InventoryTransaction[]
}

model InventoryTransaction {
  id                  String   @id @default(cuid())
  itemId              String
  maintenanceRecordId String?
  type                String   // in | out | adjustment
  quantity            Int
  unitCost            Float?
  notes               String?
  createdAt           DateTime @default(now())

  item              InventoryItem      @relation(fields: [itemId], references: [id])
  maintenanceRecord MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id])
}

// ─── Notifications & Audit ────────────────────────────────────────────────────

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  type           String   // sms | whatsapp | email | in_app
  title          String
  body           String
  isRead         Boolean  @default(false)
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String   // created | updated | deleted | status_changed | assigned | login
  entityType     String   // order | dispatch | invoice | user | driver | vehicle
  entityId       String?
  metadata       String?  // JSON string
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation("AuditUser", fields: [userId], references: [id])
  order        Order?       @relation(fields: [entityId], references: [id])
  dispatch     DispatchJob? @relation(fields: [entityId], references: [id])
}

model CompanySettings {
  id              String  @id @default(cuid())
  organizationId  String  @unique
  currency        String  @default("KES")
  timezone        String  @default("Africa/Nairobi")
  vatNumber       String?
  invoicePrefix   String  @default("INV")
  orderPrefix     String  @default("ORD")
  smsEnabled      Boolean @default(false)
  emailEnabled    Boolean @default(true)
  whatsappEnabled Boolean @default(false)
  smsSender       String?
  emailFrom       String?
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model DriverPayRate {
  id             String   @id @default(cuid())
  organizationId String
  driverId       String   @unique
  payType        String   @default("per_trip") // per_trip | per_day | both
  perTripRate    Float    @default(0)
  perDayRate     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  driver       Driver       @relation(fields: [driverId], references: [id])
}

model PayrollRun {
  id             String   @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  status         String   @default("draft") // draft | approved | paid
  totalAmount    Float    @default(0)
  notes          String?
  approvedBy     String?
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  lines        PayrollRunLine[]
}

model PayrollRunLine {
  id            String   @id @default(cuid())
  payrollRunId  String
  personType    String   @default("driver")  // "driver" | "conductor"
  driverId      String?
  conductorId   String?  // User.id when personType = "conductor"
  driverName    String
  payType       String
  tripsCount    Int      @default(0)
  daysWorked    Int      @default(0)
  perTripRate   Float    @default(0)
  perDayRate    Float    @default(0)
  tripEarnings  Float    @default(0)
  dayEarnings   Float    @default(0)
  totalEarnings Float    @default(0)
  createdAt     DateTime @default(now())

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  driver     Driver?    @relation(fields: [driverId], references: [id])
}

model CustomerPortalAccount {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String   @unique
  email          String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
}
